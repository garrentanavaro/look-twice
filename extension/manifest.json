{
  "manifest_version": 3,
  "name": "LookTwice",
  "version": "0.1.0",
  "description": "Real-time deepfake warning badge on videos (COMP6826001 final project).",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:8000/*", "http://127.0.0.1:8000/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "LookTwice" }
}
